{
  "name": "superfluid",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A responsive Python IDE for parallel Git worktrees",
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --backend-only && tsx --test 'apps/**/*.test.ts' 'packages/**/*.test.ts' 'tests/*.test.ts'",
    "test:electron": "tsx tests/electron.ts",
    "dist": "pnpm build && electron-builder --mac dir",
    "lint": "eslint .",
    "format:check": "prettier --check apps packages/contracts scripts tests vite.config.ts tsconfig.json package.json eslint.config.mjs",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/setup.mjs",
    "test:electron:repositories": "tsx tests/electronRepositories.ts"
  },
  "build": {
    "appId": "dev.superfluid.ide",
    "productName": "Superfluid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "LICENSES/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/pyright/**"
    ],
    "npmRebuild": true,
    "mac": {
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "pyright": "1.1.414",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@electron/osx-sign": "1.3.3",
    "@pierre/diffs": "1.6.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.68.0",
    "monaco-editor": "0.57.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  }
}
