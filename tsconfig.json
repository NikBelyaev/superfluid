{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./apps/web/src/*"],
      "@superfluid/contracts": ["./packages/contracts/src/index.ts"],
      "@superfluid/ghostty/*": ["./packages/ghostty/*"]
    }
  },
  "include": ["apps", "packages", "tests", "vite.config.ts"]
}
